# ThönkPad boot splash: the logo sits over the boot log (drawn behind it by
# the "script" module) and gently pulses. Pressing Escape is handled natively
# by plymouthd (ply_keyboard_add_escape_handler) - it reveals the real boot
# log underneath using ConsoleLogBackgroundColor from thonkpad.plymouth.
# There is no scripted equivalent for Enter: the log reveal is a daemon-level
# VT/console action, not something exposed to theme scripts for other keys.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.image = Image("thonkpad.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(
    Window.GetX() + Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2,
    Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2,
    10000
);

logo.opacity_angle = 0;

fun refresh_callback ()
{
    logo.opacity_angle += ((2 * 3.14) / 50) * 0.5;  # 0.5 Hz breathing
    min_opacity = 0.4;
    opacity = (Math.Cos(logo.opacity_angle) + 1) / 2;
    opacity *= 1 - min_opacity;
    opacity += min_opacity;
    logo.sprite.SetOpacity(opacity);
}

Plymouth.SetRefreshFunction(refresh_callback);

fun quit_callback ()
{
    logo.sprite.SetOpacity(1);
}

Plymouth.SetQuitFunction(quit_callback);
